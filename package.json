{
  "name": "@webship-js/craft-cms-steps",
  "version": "2.0.0",
  "description": "Craft CMS step definitions for webship-js (Playwright and Cucumber): the control panel session, navigation and notices, entries with drafts and revisions, the element index, slide-out editors, fields, assets, categories, users and permissions, and the front end.",
  "main": "tests/step-definitions/craft-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "craft-cms",
    "craftcms",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/craft-cms-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/craft-cms-steps/issues"
  },
  "homepage": "https://github.com/webship/craft-cms-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.10"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.10"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
