{# The page shell of the test site: a header with the main navigation, a breadcrumb trail, the content and a footer. #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ siteName }}{% endblock %}</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; margin: 0; color: #1f2933; }
    header, main, footer { max-width: 60rem; margin: 0 auto; padding: 1rem; }
    nav ul { list-style: none; display: flex; gap: 1rem; padding: 0; margin: 0; }
    nav[aria-label="Breadcrumb"] li + li::before { content: "/"; margin-right: 1rem; }
    a { color: #0b5fad; } a[aria-current] { font-weight: 700; }
    article { border-bottom: 1px solid #d9e2ec; padding: .5rem 0; }
    img { max-width: 100%; height: auto; }
  </style>
</head>
<body>
  <header>
    <a href="{{ siteUrl }}">{{ siteName }}</a>
    <nav aria-label="Main">
      <ul>
        <li><a href="{{ siteUrl }}"{% if craft.app.request.segments|length == 0 %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ url('blog') }}"{% if craft.app.request.getSegment(1) == 'blog' %} aria-current="page"{% endif %}>Blog</a></li>
        {% for page in craft.entries.section('pages').level(1).all() %}
          <li><a href="{{ page.url }}"{% if craft.app.request.getSegment(1) == page.slug %} aria-current="page"{% endif %}>{{ page.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </header>
  <main id="main">
    {% block breadcrumb %}{% endblock %}
    {% block content %}{% endblock %}
  </main>
  <footer><p>{{ siteName }}, {{ now|date('Y') }}</p></footer>
</body>
</html>
