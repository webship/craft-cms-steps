{% extends '_layout' %}
{% block content %}
  <h1>{{ entry.title }}</h1>
  <p class="subtitle">{{ entry.subtitle }}</p>
  <section aria-label="Featured articles">
    <h2>Featured</h2>
    <ul>
      {% for article in craft.entries.section('blog').featured(true).all() %}
        <li><a href="{{ article.url }}">{{ article.title }}</a></li>
      {% endfor %}
    </ul>
  </section>
{% endblock %}
